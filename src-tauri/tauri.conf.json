{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HD EGM Workflow",
  "version": "0.1.0",
  "identifier": "com.hd.egm-workflow",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "HD EGM Workflow", "width": 1440, "height": 900, "minWidth": 1100, "minHeight": 700 }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"]
  }
}
